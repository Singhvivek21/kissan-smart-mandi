# ==============================================================================
# KISSAN Smart Mandi - Environment Configuration Template
# Copy this file to .env and configure your keys.
# ==============================================================================

# Server Port
PORT=8080

# Google Gemini AI API Key (Required for KISSAN Saathi Multilingual Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Production Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SMS Notification Gateway Mode:
# 'mock'   = Zero-cost simulator (Default for development and hackathons)
# 'msg91'  = Production SMS gateway via MSG91 (Requires approved Indian DLT ID)
SMS_MODE=mock

# MSG91 Production Credentials (Required ONLY when SMS_MODE=msg91)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=KISSAN
# MSG91_DLT_ENTITY_ID=your_dlt_entity_id
